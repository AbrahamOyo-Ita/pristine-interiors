# ─────────────────────────────────────────────────────────────
# Pristine Interiors — environment template (no real secrets)
# Copy to .env.local and fill in values.
#
# If NEXT_PUBLIC_SUPABASE_URL is left empty the site runs in
# DEMO MODE: a local JSON data store (data/db.json) is used and
# admin sign-in uses the demo credentials below.
# ─────────────────────────────────────────────────────────────

# Public site URL used for SEO metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Public business details (rendered on the site; safe as NEXT_PUBLIC) ──
# Leave blank to keep the honest "to be confirmed" placeholders.
# WhatsApp number: country code + digits only, e.g. 2348012345678.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# Optional social profiles. Leave blank to hide the icons entirely.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_PINTEREST=

# ── Secrets (server-side only; never NEXT_PUBLIC) ──

# Supabase (production database, auth & storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo-mode admin sign-in (used only while Supabase is not configured).
# Change both before exposing the site publicly.
DEMO_ADMIN_EMAIL=owner@pristineinteriors.example
DEMO_ADMIN_PASSWORD=pristine-demo
